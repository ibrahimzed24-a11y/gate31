{
  "name": "gate31",
  "version": "0.1.0",
  "private": true,
  "description": "Gate 31 — a cross-platform DJ application",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --pretty false",
    "cap:sync": "cap sync",
    "cap:ios": "cap add ios",
    "cap:android": "cap add android",
    "electron:dev": "electron .",
    "deploy:check": "npm run build && echo 'Ready to deploy dist/ to Vercel'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.0.7"
  }
}